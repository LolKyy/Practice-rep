#!/usr/bin/env bash
# Стоп-кадры 0 с, 1 с, 3 с, середина, конец + лист-сводка + яркость первого кадра.
#   tools/check-frames <video.mp4>
set -euo pipefail
V="$1"; OUT="$(dirname "$V")/check"; mkdir -p "$OUT"
D=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$V")
i=0; for t in 0 1 3 $(python3 -c "print($D/2)") $(python3 -c "print(max(0,$D-0.2))"); do
  ffmpeg -v error -y -ss "$t" -i "$V" -frames:v 1 "$OUT/f$i.png"; i=$((i+1)); done
ffmpeg -v error -y -i "$OUT/f0.png" -i "$OUT/f1.png" -i "$OUT/f2.png" -i "$OUT/f3.png" -i "$OUT/f4.png" -filter_complex "[0][1][2][3][4]hstack=5,scale=1800:-1" "$OUT/sheet.jpg"
Y=$(ffmpeg -v error -i "$OUT/f0.png" -vf "signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=-" -f null - | grep -o "YAVG=[0-9.]*" | cut -d= -f2)
echo "кадры: $OUT  ·  яркость 1-го кадра YAVG=$Y (норма > 110 — светлое начало)"
python3 -c "import sys; sys.exit(0 if float('$Y')>110 else 1)" && echo "OK: начало светлое" || echo "ВНИМАНИЕ: тёмное начало!"
