 "shots": [
  {
   "i": 0,
   "text": "Сёма записал в блокнот: «Рим, сто семнадцатый год». И зря.",
   "s": 0.1,
   "e": 2.851
  },
  {
   "i": 1,
   "text": "Хрусть — и он легионер.",
   "s": 3.151,
   "e": 4.074
  },
  {
   "i": 2,
   "text": "Лорика — девять килограммов железа.",
   "s": 4.374,
   "e": 5.891
  },
  {
   "i": 3,
   "text": "Гладиус — короткий. Зато свой.",
   "s": 6.191,
   "e": 7.53
  },
  {
   "i": 4,
   "text": "Рост — от метра семидесяти. Сёма проходит!",
   "s": 7.83,
   "e": 9.846
  },
  {
   "i": 5,
   "text": "Жалованье — триста денариев в год. Минус еда, минус доспех, минус палатка.",
   "s": 10.146,
   "e": 13.399
  },
  {
   "i": 6,
   "text": "Шанс выжить — тридцать семь процентов.",
   "s": 13.699,
   "e": 15.253
  },
  {
   "i": 7,
   "text": "Куда отправить Сёму дальше? Пиши в комментариях.",
   "s": 15.553,
   "e": 17.829
  }
 ],
