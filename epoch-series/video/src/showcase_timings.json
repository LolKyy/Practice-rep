 "duration": 17.674,
 "shots": [
  {
   "i": 0,
   "text": "Сёма листает ленту. Вдруг — вспышка!",
   "s": 0.1,
   "e": 1.824
  },
  {
   "i": 1,
   "text": "Сто семнадцатый год. Сёма теперь — римский легионер.",
   "s": 2.124,
   "e": 4.379
  },
  {
   "i": 2,
   "text": "Лорика весит девять килограммов. Гладиус — короткий, зато свой.",
   "s": 4.679,
   "e": 7.332
  },
  {
   "i": 3,
   "text": "Рост — не ниже метра семидесяти. Сёме повезло.",
   "s": 7.632,
   "e": 9.9
  },
  {
   "i": 4,
   "text": "Жалованье — триста денариев в год. Минус еда и снаряжение.",
   "s": 10.2,
   "e": 12.945
  },
  {
   "i": 5,
   "text": "Шанс выжить — тридцать семь процентов.",
   "s": 13.245,
   "e": 14.729
  },
  {
   "i": 6,
   "text": "Куда отправить Сёму дальше? Пиши в комменты!",
   "s": 15.029,
   "e": 16.974
  }
 ],
