 ],
 "lines": [
  {
   "id": "01",
   "scene": "hook",
   "role": "narr",
   "start": 0.34,
   "end": 4.624,
   "file": "episodes/ep02/voice/fx/01_narr.mp3",
   "text": "Если стекло капсулы замёрзло изнутри — не открывай. Никогда."
  },
  {
   "id": "02",
   "scene": "recap",
   "role": "narr",
   "start": 5.134,
   "end": 8.608,
   "file": "episodes/ep02/voice/fx/02_narr.mp3",
   "text": "Ты — Глеб Северин. Бывший агент, осуждён за госизмену."
  },
  {
   "id": "03",
   "scene": "recap",
   "role": "narr",
   "start": 8.863,
   "end": 15.655,
   "file": "episodes/ep02/voice/fx/03_narr.mp3",
   "text": "Тебя закинули на «Харон-семь» — тюрьму на орбите Марса. Её захватили заключённые, и теперь она падает."
  },
  {
   "id": "04",
   "scene": "recap",
   "role": "narr",
   "start": 15.91,
   "end": 21.213,
   "file": "episodes/ep02/voice/fx/04_narr.mp3",
   "text": "Найди дочь председателя — и получишь свободу. Только сканер пока не видит ни одного живого."
  },
  {
   "id": "05",
   "scene": "hall",
   "role": "narr",
   "start": 22.063,
   "end": 26.661,
   "file": "episodes/ep02/voice/fx/05_narr.mp3",
   "text": "Палуба два. Блок капсул. Сотни спящих — и тишина."
  },
  {
   "id": "06",
   "scene": "hall",
   "role": "khor",
   "start": 27.001,
   "end": 31.311,
   "file": "episodes/ep02/voice/fx/06_khor.mp3",
   "text": "Лифт вниз — в конце зала. Не задерживайся."
  },
  {
   "id": "07",
   "scene": "hall",
   "role": "gleb",
   "start": 32.671,
   "end": 35.388,
   "file": "episodes/ep02/voice/fx/07_gleb.mp3",
   "text": "Кто-то тут пишет инструкции. Уже хорошо."
  },
  {
   "id": "07a",
   "scene": "guards",
   "role": "narr",
   "start": 36.238,
   "end": 41.201,
   "file": "episodes/ep02/voice/fx/07a_narr.mp3",
   "text": "Между рядами — охрана. Все в инее. Оружие так и осталось на полу."
  },
  {
   "id": "07b",
   "scene": "guards",
   "role": "gleb",
   "start": 41.626,
   "end": 43.245,
   "file": "episodes/ep02/voice/fx/07b_gleb.mp3",
   "text": "Даже выстрелить не успели."
  },
  {
   "id": "08",
   "scene": "ryzhy",
   "role": "ryzh",
   "start": 44.095,
   "end": 45.846,
   "file": "episodes/ep02/voice/fx/08_ryzh.mp3",
   "text": "Тише! Не свети!"
  },
  {
   "id": "09",
   "scene": "ryzhy",
   "role": "gleb",
   "start": 46.101,
   "end": 47.041,
   "file": "episodes/ep02/voice/fx/09_gleb.mp3",
   "text": "Ты кто такой?"
  },
  {
   "id": "10",
   "scene": "ryzhy",
   "role": "ryzh",
   "start": 47.296,
   "end": 52.677,
   "file": "episodes/ep02/voice/fx/10_ryzh.mp3",
   "text": "Рыжий. Блок два. Мы не бунтуем — мы прячемся."
  },
  {
   "id": "11",
   "scene": "ryzhy",
   "role": "gleb",
   "start": 52.932,
   "end": 54.108,
   "file": "episodes/ep02/voice/fx/11_gleb.mp3",
   "text": "От кого прячетесь?"
  },
  {
   "id": "12",
   "scene": "ryzhy",
   "role": "ryzh",
   "start": 54.448,
   "end": 60.691,
   "file": "episodes/ep02/voice/fx/12_ryzh.mp3",
   "text": "Внизу всех будили… и они встали другими. Холодными. Мы зовём их — стылые."
  },
  {
   "id": "12a",
   "scene": "ryzhy",
   "role": "gleb",
   "start": 61.031,
   "end": 63.487,
   "file": "episodes/ep02/voice/fx/12a_gleb.mp3",
   "text": "Погоди. Вы же бунт подняли."
  },
  {
   "id": "12b",
   "scene": "riot",
   "role": "ryzh",
   "start": 63.912,
   "end": 70.938,
   "file": "episodes/ep02/voice/fx/12b_ryzh.mp3",
   "text": "Бунтовали. Три часа назад. Потом наши выломали дверь в Блок Ноль — думали, там оружие и шаттл."
  },
  {
   "id": "12c",
   "scene": "riot",
   "role": "ryzh",
   "start": 71.363,
   "end": 77.502,
   "file": "episodes/ep02/voice/fx/12c_ryzh.mp3",
   "text": "А там были они. Двести. За час — вся охрана. И половина наших."
  },
  {
   "id": "12d",
   "scene": "sneak",
   "role": "ryzh",
   "start": 78.862,
   "end": 80.665,
   "file": "episodes/ep02/voice/fx/12d_ryzh.mp3",
   "text": "Ложись! Не дыши!"
  },
  {
   "id": "12e",
   "scene": "sneak",
   "role": "ryzh",
   "start": 83.725,
   "end": 85.188,
   "file": "episodes/ep02/voice/fx/12e_ryzh.mp3",
   "text": "Тихо… Ушёл."
  },
  {
   "id": "13",
   "scene": "hint",
   "role": "gleb",
   "start": 85.953,
   "end": 88.173,
   "file": "episodes/ep02/voice/fx/13_gleb.mp3",
   "text": "Слышь, полковник, а что за…"
  },
  {
   "id": "14",
   "scene": "hint",
   "role": "khor",
   "start": 88.215,
   "end": 91.455,
   "file": "episodes/ep02/voice/fx/14_khor.mp3",
   "text": "Не отвлекайся. Иди к лифту."
  },
  {
   "id": "14a",
   "scene": "brother",
   "role": "ryzh",
   "start": 92.305,
   "end": 96.772,
   "file": "episodes/ep02/voice/fx/14a_ryzh.mp3",
   "text": "Мой брат где-то здесь. Его не будили — он спал, когда всё началось."
  },
  {
   "id": "15",
   "scene": "brother",
   "role": "ryzh",
   "start": 98.472,
   "end": 102.285,
   "file": "episodes/ep02/voice/fx/15_ryzh.mp3",
   "text": "Слышишь? Это мой брат! Он стучит — он живой!"
  },
  {
   "id": "16",
   "scene": "brother",
   "role": "gleb",
   "start": 102.54,
   "end": 105.78,
   "file": "episodes/ep02/voice/fx/16_gleb.mp3",
   "text": "Стекло замёрзло изнутри. Ты правило читал?"
  },
  {
   "id": "17",
   "scene": "brother",
   "role": "ryzh",
   "start": 106.035,
   "end": 109.195,
   "file": "episodes/ep02/voice/fx/17_ryzh.mp3",
   "text": "Это просто холод! Он там задыхается!"
  },
  {
   "id": "18",
   "scene": "brother",
   "role": "gleb",
   "start": 109.45,
   "end": 110.966,
   "file": "episodes/ep02/voice/fx/18_gleb.mp3",
   "text": "Не трогай."
  },
  {
   "id": "19",
   "scene": "cliff",
   "role": "ryzh",
   "start": 113.686,
   "end": 114.652,
   "file": "episodes/ep02/voice/fx/19_ryzh.mp3",
   "text": "Брат…?"
  }
 ]
}