[
 {
  "start": 0.04,
  "end": 1.12,
  "text": "Что делать Диме?"
 },
 {
  "start": 1.32,
  "end": 3.16,
  "text": "Крикнуть: «Я один!»"
 },
 {
  "start": 3.24,
  "end": 6.36,
  "text": "Но оно повторит, и машинист услышит двоих."
 },
 {
  "start": 6.52,
  "end": 9.0,
  "text": "Или чиркнуть зажигалкой в последний раз?"
 },
 {
  "start": 9.24,
  "end": 10.92,
  "text": "Огонь оно не повторит."
 },
 {
  "start": 11.0,
  "end": 12.76,
  "text": "Только газа может не хватить."
 }
